# Copy to .env and adjust before running `docker compose up`.

# ---- Database (PostgreSQL) ----
# Local docker-compose Postgres credentials. In real production these point at your managed
# Postgres instance instead (Railway Postgres, RDS, ...) via MANARAH_DB_URL/USERNAME/PASSWORD.
POSTGRES_DB=manarah
POSTGRES_USER=manarah
POSTGRES_PASSWORD=

# ---- Redis (rate limiting, shared across backend instances) ----
# Required - Redis has no password by default, and anyone who reaches it on the network could
# read/tamper with rate-limit counters. Generate one with: openssl rand -base64 24
MANARAH_REDIS_PASSWORD=

# ---- Object storage (S3-compatible) ----
# Required once you run more than one backend instance - see the scaling note at the bottom of
# docker-compose.yml. Local dev uses the bundled MinIO service; production points these at a real
# provider (Cloudflare R2, AWS S3, Backblaze B2, ...).
MANARAH_STORAGE_PROVIDER=local
MANARAH_S3_BUCKET=manarah-files
MINIO_ROOT_USER=manarah
MINIO_ROOT_PASSWORD=

# ---- Email (welcome QR at registration, password reset) ----
# The public address people reach the site on. Required for emailed links and QR codes to work.
MANARAH_PUBLIC_APP_URL=
# Off by default: without SMTP nothing is sent (it is logged instead). Gmail needs an App Password.
MANARAH_EMAIL_ENABLED=false
MANARAH_EMAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ---- Backend security ----
# Base64-encoded 256-bit JWT signing secret. Required; there is intentionally no fallback.
# Generate one with: openssl rand -base64 32
MANARAH_JWT_SECRET=
MANARAH_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
MANARAH_COOKIE_SECURE=false
MANARAH_API_DOCS_ENABLED=false

# Local demonstration data only. Set seed-enabled=false in every production environment.
MANARAH_DEMO_SEED_ENABLED=false
MANARAH_DEMO_PASSWORD=

# ---- WhatsApp (Meta Cloud API) ----
# Leave WHATSAPP_ENABLED=false to keep the safe stub sender (logs only, sends nothing).
MANARAH_WHATSAPP_ENABLED=false
MANARAH_WHATSAPP_ACCESS_TOKEN=
MANARAH_WHATSAPP_PHONE_NUMBER_ID=
MANARAH_WHATSAPP_APP_SECRET=
MANARAH_WHATSAPP_VERIFY_TOKEN=

# ---- AI question generation (OpenRouter or any OpenAI-compatible endpoint) ----
# Leave MANARAH_AI_ENABLED=false to keep the feature disabled (returns a clear error
# instead of silently doing nothing).
MANARAH_AI_ENABLED=false
MANARAH_AI_BASE_URL=https://openrouter.ai/api/v1
MANARAH_AI_API_KEY=
MANARAH_AI_MODEL=inclusionai/ling-3.0-flash-fin:free

# ---- Published ports ----
BACKEND_PORT=8091
FRONTEND_PORT=80
# Video encryption: configure server-side only; never expose this secret in the frontend.
MANARAH_VDOCIPHER_SECRET=
# Enable after migrating lesson videos to VdoCipher. Blocks all non-DRM lesson playback.
MANARAH_VIDEO_REQUIRE_DRM=false
# Devices one account may stream on at the same time (a new device replaces the oldest session).
MANARAH_VIDEO_MAX_SESSIONS=1
# Refuse video stream requests that lack the browser's <video> fetch metadata (download managers, curl).
MANARAH_VIDEO_REQUIRE_BROWSER_FETCH=true
